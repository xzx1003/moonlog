{
  "detector": "moving-average",
  "ewma-alpha": 0.3,
  "mad-threshold": 3,
  "bucket-minutes": 5,
  "baseline-buckets": 6,
  "multiplier": 3,
  "min-errors": 3,
  "context": 10,
  "context-mode": "spikes",
  "sampling": "first",
  "max-samples": 20,
  "max-buckets": 100000,
  "max-signatures": 1000,
  "max-line-bytes": 65536,
  "json-time-field": "ts",
  "json-level-field": "level",
  "json-message-field": "msg",
  "redact-text": [
    {
      "needle": "replace-with-a-literal-secret",
      "replacement": "[REDACTED]"
    }
  ],
  "redact-fields": [
    "token",
    "password"
  ],
  "format": "markdown"
}
